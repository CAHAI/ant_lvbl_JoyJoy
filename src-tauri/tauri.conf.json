{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Joy-Joy OS",
  "version": "0.1.0",
  "identifier": "com.cahai.joyjoy",
  "build": {
    "beforeDevCommand": "bun node_modules/vite/bin/vite.js dev",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "bun node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Joy-Joy OS",
        "width": 460,
        "height": 820,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../public/favicon.ico"
    ]
  }
}
